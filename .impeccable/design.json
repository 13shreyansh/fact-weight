  "narrative": {
    "northStar": "The Registered-Mail Counter",
    "overview": "Every copy of a story is treated as a forwarded letter: stamped with site, country and minutes-after-original, filed on ruled label stock, and sorted at a sorting-office counter. Postal yellow owns whole fields (top bar, hero, country header, footer); black ink rules everything into boxes; white label stock carries the evidence. The world refuses the dark threat-intel dashboard with a glowing globe. The one dark field is the sorting rack, an ink sheet of country pigeonholes.\n\nDensity is clerical and confident: flat, ruled, zero-radius boxes divided by 2px black rules, heavy condensed caps for signage, plain Barlow for reading, monospace only where a clerk would stamp a number. Ink is not perfect: postmarks pass through an SVG turbulence filter, stamps and slips sit a degree or two off square, and postmarks press in on arrival.",
    "keyCharacteristics": [
      "Yellow fields, black 2px rules, white label stock.",
      "Heavy uppercase condensed signage over a quiet sans body.",
      "Circular postmarks and rotated rubber stamps carry every verdict.",
      "Square corners everywhere; circles only for postmarks and route/step dots.",
      "Tabular numerals site-wide; mono reserved for times, lags, codes, URLs."
    ],
    "rules": [
      {
        "name": "The One Meaning Rule",
        "body": "Blue is mainstream, red is coordinated copying, green is organic. None of them decorates; none crosses into another's verdict.",
        "section": "colors"
      },
      {
        "name": "The Yellow Field Rule",
        "body": "Yellow is applied as a full-bleed field bounded by a 2px ink rule, never as a small accent chip on grey.",
        "section": "colors"
      },
      {
        "name": "The Signage Case Rule",
        "body": "Interface headings are uppercase condensed caps; quoted story headlines are never uppercased.",
        "section": "typography"
      },
      {
        "name": "The Clerk's Numbers Rule",
        "body": "Mono only for times, lags, IDs and URLs. Counts are big condensed figures, not mono.",
        "section": "typography"
      },
      {
        "name": "The Ruled Not Raised Rule",
        "body": "Separate things with a 2px ink rule. Do not add a shadow to a card to make it a card.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do fill whole fields with postal yellow and bound them with a 2px ink rule.",
      "Do put evidence on white label stock in ruled, zero-radius boxes with a label head.",
      "Do carry verdicts as stamps or postmarks in their one colour: red coordinated, green organic, muted no-data, blue mainstream.",
      "Do keep mono to times, lags, codes and URLs, and keep tabular numerals on.",
      "Do respect reduced motion: postmark press, step pulse and skeleton shimmer all stop."
    ],
    "donts": [
      "Don't build a dark threat-intel dashboard, glowing globe, or neon-on-black data UI.",
      "Don't round corners on boxes, buttons, fields or chips.",
      "Don't use cancellation red for anything that is not coordinated-copy evidence or a failure.",
      "Don't add drop shadows to containers; the hero slip's paper lift is the only one.",
      "Don't uppercase a quoted story headline."
    ]
  }
}